[gd_scene format=3 uid="uid://dyjhnxxqfrnoo"]

[ext_resource type="PackedScene" uid="uid://b8cwnoqughv10" path="res://hand/hand.tscn" id="1_bgou6"]

[sub_resource type="GDScript" id="GDScript_fm8fw"]
script/source = "extends Node3D

@onready var passed_array: PackedFloat32Array = [0, 0, 0, 0, 0]
@onready var target_array: PackedFloat32Array = [0, 0, 0, 0, 0]
func _ready() -> void:
	$Hand.process_glove_data(passed_array)

func _process(delta: float) -> void:
	for digit in target_array.size():
		if passed_array[digit] != target_array[digit]:
			pass
	$Hand.rotate_y(.3 * delta)

func _unhandled_key_input(event: InputEvent) -> void:
	if event.is_action(\"curl_thumb\"):
			passed_array[0] = 0 if event.is_released() else 1023
	if event.is_action(\"curl_index\"):
			passed_array[1] = 0 if event.is_released() else 1023
	if event.is_action(\"curl_middle\"):
			passed_array[2] = 0 if event.is_released() else 1023
	if event.is_action(\"curl_ring\"):
			passed_array[3] = 0 if event.is_released() else 1023
	if event.is_action(\"curl_little\"):
			passed_array[4] = 0 if event.is_released() else 1023
	$Hand.process_glove_data(passed_array)

func _on_thumb_value_changed(value: float) -> void:
	passed_array[0] = value
	$Hand.process_glove_data(passed_array)

func _on_index_value_changed(value: float) -> void:
	passed_array[1] = value
	$Hand.process_glove_data(passed_array)

func _on_middle_value_changed(value: float) -> void:
	passed_array[2] = value
	$Hand.process_glove_data(passed_array)

func _on_ring_value_changed(value: float) -> void:
	passed_array[3] = value
	$Hand.process_glove_data(passed_array)

func _on_little_value_changed(value: float) -> void:
	passed_array[4] = value
	$Hand.process_glove_data(passed_array)
"

